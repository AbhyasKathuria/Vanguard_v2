# 2. Authentication & Session Security
JWT_SECRET="vanguard_rural_routing_secret_key_2026_super_secure"

# 3. Meta WhatsApp Cloud API (Optional - Zero-Key Simulator active by default)
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
